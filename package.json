{
  "name": "hsr-companion",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "description": "HSR Companion — application de bureau (Tauri)",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:dev": "tauri build --debug --no-bundle && node -e \"require('fs').mkdirSync('release/dev',{recursive:true});require('fs').copyFileSync('src-tauri/target/debug/hsr-companion.exe','release/dev/HSR-Companion-dev.exe')\"",
    "release": "node tools/release.mjs",
    "icons": "tauri icon icon.svg",
    "test": "node --test \"tests/*.test.mjs\" && cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
