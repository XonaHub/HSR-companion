{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HSR Companion",
  "version": "1.0.0",
  "identifier": "fr.hsrcompanion.desktop",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
